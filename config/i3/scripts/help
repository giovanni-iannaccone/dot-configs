#!/bin/sh

CONFIG="$HOME/.config/i3/keybinds.conf"

awk '
/^[[:space:]]*#[[:space:]]*/ {
    desc = $0
    sub(/^[[:space:]]*#[[:space:]]*/, "", desc)
    next
}

/^[[:space:]]*bindsym[[:space:]]/ {
    line = $0
    sub(/^[[:space:]]*bindsym[[:space:]]+/, "", line)

    key = line
    sub(/[[:space:]].*$/, "", key)

    gsub(/\$mod/, "Super", key)
    gsub(/Control/, "Ctrl", key)
    gsub(/Mod1/, "Alt", key)
    gsub(/Mod4/, "Super", key)
    gsub(/Return/, "Enter", key)
    gsub(/BackSpace/, "Backspace", key)
    gsub(/Escape/, "Esc", key)
    gsub(/space/, "Space", key)

    if (desc != "")
        printf "%-30s %s\n", key, desc

    desc = ""
    next
}

/^[[:space:]]*$/ {
    next
}

{
    desc = ""
}
' "$CONFIG" | ~/.config/dmenu/dmenu.sh -l 20 -p 'Keybindings:' >/dev/null
