#!/bin/sh

KEYBINDINGS=$(awk '
    /^[a-z]/ && last {
        printf "%-30s | %s\n", $0, last
    }
    { last="" }
    /^#/ { last=substr($0, 3) }
' ~/.config/i3/sxhkd/sxhkdrc)

[ -n "$KEYBINDINGS" ] || exit 0

SELECTED=$(
    printf '%s\n' "$KEYBINDINGS" |
    dmenu \
        -i \
        -fn 'JetBrainsMono Nerd Font-12' \
        -nb '#000000' \
        -nf '#F2F4C8' \
        -sb '#4C7899' \
        -sf '#FFFFFF' \
        -l 20 \
        -p 'Keybindings:'
)

[ -n "$SELECTED" ] || exit 0

COMMAND=$(printf '%s\n' "$SELECTED" |
    cut -d'|' -f1 |
    sed 's/[[:space:]]*$//' |
    sed 's/^[[:space:]]*//')

[ -n "$COMMAND" ] || exit 0

nohup sh -c "$COMMAND" >/dev/null 2>&1 &
