#!/bin/sh

chosen=$(
    printf '%s\n' \
        "󰌾  Lock" \
        "󰍃  Logout" \
        "󰐥  Shutdown" \
        "󰜉  Reboot" | ~/.config/dmenu/dmenu.sh -p 'Power:'
)

case "$chosen" in
    "󰌾  Lock")
        exec i3lock \
            --nofork \
            --show-failed-attempts \
            --ignore-empty-password \
            --tiling \
            -c 000000
        ;;

    "󰍃  Logout")
        exec i3-msg exit
        ;;

    "󰐥  Shutdown")
        systemctl poweroff
        ;;

    "󰜉  Reboot")
        systemctl reboot
        ;;

    *)
        exit 0
        ;;
esac
