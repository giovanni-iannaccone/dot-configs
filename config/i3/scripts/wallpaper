#!/bin/sh

wall_dir="${HOME}/.config/wallpapers"

wall_selection=$(
    find "$wall_dir" \
        -maxdepth 1 \
        -type f \
        \( \
            -iname "*.jpg" \
            -o -iname "*.jpeg" \
            -o -iname "*.png" \
            -o -iname "*.webp" \
        \) \
        -exec basename {} \; |
    sort |
    ~/.config/dmenu/dmenu.sh -p 'Wallpaper:'
)

[ -n "$wall_selection" ] || exit 0

wallpaper="${wall_dir}/${wall_selection}"

feh --bg-fill "$wallpaper" &

printf '%s\n' "$wallpaper" > "${HOME}/.config/default"
