#!/usr/bin/env bash

FONT='JetBrainsMono Nerd Font-12'
BG='#000000'
FG='#F2F4F8'
ACCENT='#4C7899'
WHITE='#FFFFFF'
BACK="󰌍  Back"
NETWORK_LINES=10
SAVED_LINES=10

command -v nmcli >/dev/null 2>&1 || { notify-send "Wi-Fi" "nmcli not found"; exit 1; }
command -v dmenu >/dev/null 2>&1 || { notify-send "Wi-Fi" "dmenu not found"; exit 1; }

dmenu_cmd() {
    dmenu -i -fn "$FONT" -nb "$BG" -nf "$FG" -sb "$ACCENT" -sf "$WHITE" "$@"
}

wifi_interface() {
    nmcli -t -f DEVICE,TYPE device 2>/dev/null |
        awk -F: '$2=="wifi" && $1!="" {print $1; exit}'
}

wifi_enabled() {
    [ "$(nmcli radio wifi 2>/dev/null)" = "enabled" ]
}

wifi_title() {
    local iface connection
    iface=$(wifi_interface)
    [ -z "$iface" ] && { echo "󰤭  Wi-Fi  |  No interface"; return; }
    connection=$(nmcli -t -f GENERAL.CONNECTION device show "$iface" 2>/dev/null | cut -d: -f2-)
    if [ -n "$connection" ] && [ "$connection" != "--" ]; then
        echo "󰤨  Wi-Fi  |  $connection"
    else
        echo "󰤭  Wi-Fi  |  Disconnected"
    fi
}

signal_icon() {
    case "$1" in
        9[0-9]|100) echo "󰤨" ;;
        [6-8][0-9]) echo "󰤥" ;;
        [4-5][0-9]) echo "󰤢" ;;
        [2-3][0-9]) echo "󰤟" ;;
        *) echo "󰤯" ;;
    esac
}

security_icon() {
    case "$1" in
        *WPA3*) echo "󰌿" ;;
        *WPA*) echo "󰌾" ;;
        *) echo "󰷛" ;;
    esac
}

password_prompt() {
    local prompt="$1"
    if dmenu -h 2>&1 | grep -q -- '-P'; then
        printf '' | dmenu_cmd -P -p "$prompt"
    elif command -v zenity >/dev/null 2>&1; then
        zenity --password --title="Wi-Fi" --text="$prompt"
    else
        notify-send "Wi-Fi" "Install dmenu-password or zenity"
        return 1
    fi
}

main_menu() {
    local choice iface

    while true; do
        iface=$(wifi_interface)

        if [ -z "$iface" ]; then
            choice=$(
                printf '%s\n' \
                    "󰤭  No Wi-Fi interface detected" \
                    "󰈆  Exit" |
                dmenu_cmd -l 2 -p "Wi-Fi"
            )
            [ "$choice" = "󰈆  Exit" ] || [ -z "$choice" ] && exit 0
            continue
        fi

        if ! wifi_enabled; then
            choice=$(
                printf '%s\n' \
                    "󰤨  Enable Wi-Fi" \
                    "󰈆  Exit" |
                dmenu_cmd -l 2 -p "󰤭  Wi-Fi | Disabled"
            )
            case "$choice" in
                "󰤨  Enable Wi-Fi")
                    nmcli radio wifi on >/dev/null 2>&1 &&
                        notify-send "Wi-Fi" "Enabled" ||
                        notify-send "Wi-Fi" "Failed to enable Wi-Fi"
                    ;;
                *) exit 0 ;;
            esac
            continue
        fi

        choice=$(
            printf '%s\n' \
                "󰤨  Scan Networks" \
                "󰈀  Saved Networks" \
                "󰤭  Toggle Wi-Fi" \
                "󰤮  Disconnect" \
                "󰋗  Information" |
            dmenu_cmd -l 5 -p "$(wifi_title)"
        )

        case "$choice" in
            "󰤨  Scan Networks") scan_menu ;;
            "󰈀  Saved Networks") saved_menu ;;
            "󰤭  Toggle Wi-Fi")
                if wifi_enabled; then
                    nmcli radio wifi off >/dev/null 2>&1 &&
                        notify-send "Wi-Fi" "Disabled" ||
                        notify-send "Wi-Fi" "Failed to disable Wi-Fi"
                else
                    nmcli radio wifi on >/dev/null 2>&1 &&
                        notify-send "Wi-Fi" "Enabled" ||
                        notify-send "Wi-Fi" "Failed to enable Wi-Fi"
                fi
                ;;
            "󰤮  Disconnect")
                if nmcli device disconnect "$iface" >/dev/null 2>&1; then
                    notify-send "Wi-Fi" "Disconnected"
                else
                    notify-send "Wi-Fi" "Nothing to disconnect"
                fi
                ;;
            "󰋗  Information") info_menu ;;
            "") exit 0 ;;
        esac
    done
}

scan_menu() {
    local iface saved choice ssid signal security freq active band state
    local line data rest freq_int security_display entries="$BACK"
    declare -A best_networks network_map

    iface=$(wifi_interface)
    [ -z "$iface" ] && { notify-send "Wi-Fi" "No Wi-Fi interface detected"; return; }
    wifi_enabled || { notify-send "Wi-Fi" "Wi-Fi is disabled"; return; }

    notify-send "Wi-Fi" "Scanning networks..."
    nmcli device wifi rescan >/dev/null 2>&1 || {
        notify-send "Wi-Fi" "Failed to start Wi-Fi scan"
        return
    }
    sleep 2

    saved=$(nmcli -t -f NAME connection show 2>/dev/null)

    while IFS=: read -r active ssid signal security freq; do
        [ -z "$ssid" ] || [ "$ssid" = "--" ] || [ -z "$signal" ] && continue
        case "$signal" in ''|*[!0-9]*) continue ;; esac
        data="${best_networks[$ssid]:-}"
        if [ -z "$data" ] || [ "$signal" -gt "${data%%:*}" ] 2>/dev/null; then
            best_networks["$ssid"]="$signal:$active:$security:$freq"
        fi
    done < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,FREQ device wifi list 2>/dev/null)

    [ "${#best_networks[@]}" -eq 0 ] && {
        printf '%s\n' "$BACK" "󰤯  No networks found" |
            dmenu_cmd -l 2 -p "󰤨 Networks" >/dev/null
        return
    }

    while IFS= read -r ssid; do
        data="${best_networks[$ssid]}"
        signal="${data%%:*}"
        rest="${data#*:}"
        active="${rest%%:*}"
        rest="${rest#*:}"
        security="${rest%%:*}"
        freq="${rest#*:}"

        if [ "$active" = "*" ]; then
            state="󰄬"
        elif printf '%s\n' "$saved" | grep -Fqx -- "$ssid"; then
            state="󰇖"
        else
            state=" "
        fi

        freq_int=${freq%.*}
        [ -n "$freq_int" ] && [ "$freq_int" -gt 4000 ] 2>/dev/null &&
            band="5GHz" || band="2.4GHz"

        security_display="${security:-OPEN}"
        line=$(printf "%s  %-28s  %s  %3s%%  %-5s %-7s %s" \
            "$state" "$ssid" "$(signal_icon "$signal")" "$signal" \
            "$(security_icon "$security")" "$security_display" "$band")

        entries+=$'\n'"$line"
        network_map["$line"]="$ssid"
    done < <(
        for ssid in "${!best_networks[@]}"; do
            data="${best_networks[$ssid]}"
            printf '%s\t%s\n' "${data%%:*}" "$ssid"
        done | sort -rn | cut -f2-
    )

    choice=$(printf '%s\n' "$entries" | dmenu_cmd -l "$NETWORK_LINES" -p "󰤨 Networks")
    [ "$choice" = "$BACK" ] || [ -z "$choice" ] && return

    ssid="${network_map[$choice]:-}"
    [ -z "$ssid" ] && return

    [ "$(nmcli -t -f GENERAL.CONNECTION device show "$iface" 2>/dev/null | cut -d: -f2-)" = "$ssid" ] && {
        notify-send "Wi-Fi" "Already connected to $ssid"
        return
    }

    nmcli device wifi connect "$ssid" ifname "$iface" >/dev/null 2>&1 && {
        notify-send "Wi-Fi" "Connected: $ssid"
        return
    }

    local password
    password=$(password_prompt "󰌾 Password") || return
    [ -z "$password" ] && return

    if nmcli device wifi connect "$ssid" password "$password" ifname "$iface" >/dev/null 2>&1; then
        notify-send "Wi-Fi" "Connected: $ssid"
    else
        notify-send "Wi-Fi" "Connection failed: $ssid"
    fi
}

saved_menu() {
    local choice

    while true; do
        choice=$(
            {
                printf '%s\n' "$BACK"
                nmcli -t -f NAME connection show 2>/dev/null
            } |
            dmenu_cmd -l "$SAVED_LINES" -p "󰈀 Saved Networks"
        )

        case "$choice" in
            "$BACK"|"") return ;;
        esac

        saved_network_actions "$choice"
    done
}

saved_network_actions() {
    local network="$1" action confirm

    while true; do
        action=$(
            printf '%s\n' \
                "󰤨  Connect" \
                "󰆴  Forget Network" \
                "$BACK" |
            dmenu_cmd -l 3 -p "$network"
        )

        case "$action" in
            "󰤨  Connect")
                if nmcli connection up "$network" >/dev/null 2>&1; then
                    notify-send "Wi-Fi" "Connected to $network"
                else
                    notify-send "Wi-Fi" "Connection failed"
                fi
                return
                ;;
            "󰆴  Forget Network")
                confirm=$(
                    printf '%s\n' "Yes" "No" |
                    dmenu_cmd -l 2 -p "Forget \"$network\"?"
                )
                [ "$confirm" != "Yes" ] && continue

                if nmcli connection delete "$network" >/dev/null 2>&1; then
                    notify-send "Wi-Fi" "Removed \"$network\""
                    return
                else
                    notify-send "Wi-Fi" "Failed to remove \"$network\""
                fi
                ;;
            "$BACK"|"") return ;;
        esac
    done
}

info_menu() {
    local iface device_info connection mac ip gateway dns iw_bin link
    local ssid freq signal rxrate txrate width band info

    iface=$(wifi_interface)
    [ -z "$iface" ] && {
        notify-send "Wi-Fi" "No Wi-Fi interface detected"
        return
    }

    device_info=$(nmcli device show "$iface" 2>/dev/null)

    get_nmcli() {
        echo "$device_info" |
            grep -m1 "$1" |
            sed 's/^[^:]*:[[:space:]]*//'
    }

    connection=$(get_nmcli "GENERAL.CONNECTION")
    mac=$(get_nmcli "GENERAL.HWADDR")
    ip=$(get_nmcli "IP4.ADDRESS")
    gateway=$(get_nmcli "IP4.GATEWAY")

    dns=$(echo "$device_info" |
        grep 'IP4.DNS' |
        sed 's/^[^:]*:[[:space:]]*//' |
        tr '\n' ' ')

    iw_bin=$(command -v iw 2>/dev/null)

    [ -z "$iw_bin" ] && [ -x /usr/sbin/iw ] && iw_bin=/usr/sbin/iw
    [ -z "$iw_bin" ] && [ -x /usr/bin/iw ] && iw_bin=/usr/bin/iw

    if [ -n "$iw_bin" ]; then
        link=$("$iw_bin" dev "$iface" link 2>/dev/null)
    else
        link=""
    fi

    ssid=$(printf '%s\n' "$link" |
        awk -F': ' '/^[[:space:]]*SSID:/ {
            print $2
            exit
        }')

    freq=$(printf '%s\n' "$link" |
        awk '/^[[:space:]]*freq:/ {
            print $2
            exit
        }')

    freq=${freq%.*}

    signal=$(printf '%s\n' "$link" |
        awk '/^[[:space:]]*signal:/ {
            print $2
            exit
        }')

    rxrate=$(printf '%s\n' "$link" |
        sed -n 's/^[[:space:]]*rx bitrate: //p' |
        head -n1)

    txrate=$(printf '%s\n' "$link" |
        sed -n 's/^[[:space:]]*tx bitrate: //p' |
        head -n1)

    width=$(printf '%s\n' "$link" |
        grep -oE '[0-9]+MHz' |
        head -n1)

    [ -n "$width" ] && width="${width%MHz} MHz"

    case "$freq" in
        2[4-9][0-9][0-9]|24[0-9][0-9])
            band="2.4 GHz"
            ;;
        5[0-9][0-9][0-9])
            band="5 GHz"
            ;;
        6[0-9][0-9][0-9])
            band="6 GHz"
            ;;
        *)
            band="Unknown"
            ;;
    esac

    info="󰤨  SSID:          ${ssid:-Unknown}
󰖩  Interface:      ${iface}
󰈀  MAC:            ${mac:-Unknown}
󰩟  IP:             ${ip:-Unknown}
󰒍  Gateway:        ${gateway:-Unknown}
󰇖  DNS:            ${dns:-Unknown}
󰤨  Signal:         ${signal:-Unknown} dBm
󰓅  TX Speed:       ${txrate:-Unknown}
󰓅  RX Speed:       ${rxrate:-Unknown}
󰈙  Frequency:      ${freq:-Unknown} MHz
󰥔  Band:           ${band:-Unknown}
󰒌  Bandwidth:      ${width:-Unknown}"

    printf '%s\n' "$info" |
        dmenu_cmd -l 12 -p "󰋗 Wi-Fi Information" >/dev/null
}

main_menu
