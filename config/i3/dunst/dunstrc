[global]

font = JetBrainsMono Nerd Font 11

width = 360
height = 110

origin = top-right
offset = 24x40

padding = 12
horizontal_padding = 14

frame_width = 2
frame_color = "#22C55E"

gap_size = 24

background = "#05070A"
foreground = "#E8F1FF"

stack_duplicates = true
transparency = 8

icon_position = left
max_icon_size = 42

markup = full

format = "<b>%s</b>\n%b"

[urgency_low]

background = "#06130B"
foreground = "#BBF7D0"
frame_color = "#22C55E"

timeout = 4

[urgency_normal]

background = "#151204"
foreground = "#FEF3C7"
frame_color = "#FACC15"

timeout = 6

[urgency_critical]

background = "#180607"
foreground = "#FECACA"
frame_color = "#EF4444"

timeout = 10
